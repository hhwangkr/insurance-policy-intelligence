FROM python:3.12-slim-bookworm AS runtime

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY packages/shared/pyproject.toml packages/shared/pyproject.toml
COPY packages/evaluation/pyproject.toml packages/evaluation/pyproject.toml
COPY packages/retrieval/pyproject.toml packages/retrieval/pyproject.toml
COPY packages/ingestion/pyproject.toml packages/ingestion/pyproject.toml

COPY apps/api/src apps/api/src
COPY packages/shared/src packages/shared/src
COPY packages/evaluation/src packages/evaluation/src
COPY packages/retrieval/src packages/retrieval/src
COPY packages/ingestion/src packages/ingestion/src

RUN uv sync --frozen --no-dev --package insurance-ai-api

ENV PATH="/workspace/.venv/bin:${PATH}"

EXPOSE 8000

CMD ["uvicorn", "insurance_ai_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
