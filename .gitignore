# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/

# uv
.uv/

# Environment files (keep .env.example tracked)
.env
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/
*.egg

# Full processed document JSON outputs (curated samples live under examples/processed_documents/)
data/processed/documents/*.json
data/processed/sections/*.json

# Generated ingestion quality reports (optional markdown output from inspect_documents)
data/processed/reports/*.md

# Optional query-time citation context JSON (debug / examples only; see README and docs/retrieval_baseline.md)
data/processed/reports/*citation_context*.json

# Generated chunk artifacts
data/processed/chunks/*.chunks.json
!data/processed/chunks/.gitkeep

# Local vector index (retrieval baseline; build_index output)
data/processed/index/*
!data/processed/index/.gitkeep
